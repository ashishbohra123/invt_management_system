{
  "name": "invt-management-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "src/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,admin,partner,customer -c blue,green,yellow,magenta \"npm run dev -w @moc/server\" \"npm run dev -w @moc/admin-portal\" \"npm run dev -w @moc/partner-portal\" \"npm run dev -w @moc/customer-portal\"",
    "build": "npm run build -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "test": "npm run test -ws --if-present",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.0",
    "pg": "^8.22.0",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {}
}
