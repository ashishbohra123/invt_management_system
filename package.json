{
  "name": "invt-management-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "src/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,admin -c blue,green \"npm run dev -w @moc/server\" \"npm run dev -w @moc/admin-portal\"",
    "build": "npm run build -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "test": "npm run test -ws --if-present",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.0",
    "pg": "^8.22.0",
    "playwright": "^1.61.1",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  }
}
